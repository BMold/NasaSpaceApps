{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ares-twin.local/schemas/plan_actualizado.json",
  "title": "Plan actualizado (§11.3)",
  "allOf": [
    {
      "$ref": "comunes.json#/$defs/mensaje_base"
    },
    {
      "required": [
        "motivo",
        "seq_evento",
        "plan"
      ],
      "properties": {
        "tipo": {
          "const": "plan_actualizado"
        },
        "motivo": {
          "enum": [
            "inicial",
            "peligro",
            "recalibracion",
            "ventana",
            "spe_alerta",
            "pedido"
          ]
        },
        "seq_evento": {
          "type": [
            "integer",
            "null"
          ]
        },
        "plan": {
          "$ref": "plan.json"
        }
      }
    }
  ]
}
